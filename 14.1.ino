// Подключаем библиотеки
#include <Wire.h>                 // Для I2C
#include <LiquidCrystal_I2C.h>    // Для LCD дисплея

// --- Настройки компонентов ---

// Пины для ультразвукового датчика HC-SR04
const int TRIG_PIN = 8; // Пин Trig (выход)
const int ECHO_PIN = 7; // Пин Echo (вход)

// LCD Дисплей (I2C)
// Убедитесь, что адрес 0x27 верный (иногда бывает 0x3F)
LiquidCrystal_I2C lcd(0x27, 16, 2); // Адрес 0x27, размер 16x2

// --- Глобальные переменные ---
long duration;    // Переменная для хранения времени эха (в микросекундах)
float distance; // Переменная для хранения расстояния (в сантиметрах)

void setup() {
  Serial.begin(9600); // Запускаем Монитор порта для отладки

  // Инициализация LCD
  lcd.init();
  lcd.backlight();
  lcd.print("Eho-Ruletka");
  lcd.setCursor(0, 1);
  lcd.print("Startu_...");
  delay(1000);
  lcd.clear();

  // Настраиваем пины для HC-SR04
  pinMode(TRIG_PIN, OUTPUT); // Пин Trig - это выход (посылает "крик")
  pinMode(ECHO_PIN, INPUT);  // Пин Echo - это вход (слушает "эхо")
}

void loop() {

  // --- Шаг 1: Отправка "крика" (импульса 10 мкс) ---

  // Для генерации чистого импульса, сначала выключаем Trig
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2); // Короткая пауза

  // Посылаем 10-микросекундный импульс (сигнал HIGH)
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW); // Сразу выключаем

// --- Шаг 2: Чтение "эха" ---

// Функция pulseIn() "зависает" на этом шаге и ждет:
// 1. Пока на ECHO_PIN не появится HIGH (эхо пошло)
// 2. Измеряет, как долго (в мкс) этот пин был в состоянии HIGH
// 3. Возвращает это время, как только пин снова станет LOW (эхо вернулось)
duration = pulseIn(ECHO_PIN, HIGH);

// --- Шаг 3: Расчет расстояния ---

// Скорость звука = 0.0343 см/мкс
// Время (duration) - это время полета звука ТУДА и ОБРАТНО.
// Нам нужно расстояние в одну сторону, поэтому делим время на 2.
// Формула: Расстояние = (Скорость * Время) / 2
// distance = (duration * 0.0343) / 2;
// или (что математически то же самое и чуть быстрее):
distance = duration * 0.01715;

// --- Шаг 4: Вывод на LCD ---

lcd.clear(); // Очищаем экран перед новым выводом
lcd.setCursor(0, 0); // Ставим курсор в начало (0-я колонка, 0-я строка)
lcd.print("Distantsiya:");

lcd.setCursor(0, 1); // Ставим курсор в начало (0-я колонка, 1-я строка)
lcd.print(distance); // Выводим посчитанное расстояние
lcd.print(" cm");

// --- Шаг 5: Вывод в Монитор порта (для отладки) ---
  Serial.print("Dlitelnost: ");
  Serial.print(duration);
  Serial.print(" mks | Dist: ");
  Serial.print(distance);
  Serial.println(" cm");

  // Ждем немного (250 мс) перед следующим измерением,
  // чтобы экран не мерцал слишком быстро.
  delay(250);
}
